# Copy to .env and adjust for your environment.
# Quarkus reads .env from the application working directory (or pass via system properties).

## CORS
CORS_ALLOWED_ORIGINS=https?://(localhost|127\.0\.0\.1)(:[0-9]+)?

## Downstream service URLs (defaults match the localhost dev setup)
FISCHL_IDENTITY_URL=http://localhost:3001
FISCHL_BASTION_URL=http://localhost:3002
FISCHL_FACILITIES_URL=http://localhost:3002
FISCHL_NEWSPAPERS_URL=http://localhost:3003
FISCHL_DEFENDER_URL=http://localhost:3002
FISCHL_HIRELING_URL=http://localhost:3002

## Discord webhook URLs (one per channel; create in Discord: channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_INDIVIDUAL_BASTION_TURN_URL=
DISCORD_WEBHOOK_BASTION_CREATION_URL=
DISCORD_WEBHOOK_FACILITY_BUILT_URL=
DISCORD_WEBHOOK_FACILITY_RANK_UP_URL=
DISCORD_WEBHOOK_BRANCH_UPGRADE_URL=
DISCORD_WEBHOOK_HIRELING_HIRED_URL=
DISCORD_WEBHOOK_DEFENDER_ACQUIRED_URL=
